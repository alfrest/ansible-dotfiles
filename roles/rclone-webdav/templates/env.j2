# Rendered by the rclone-webdav role on every play. Do not edit on the host: the
# next run overwrites this file. Change templates/env.j2 or the vault entry instead.

# The host uid/gid the container runs as.
PUID={{ srv_puid }}
PGID={{ srv_pgid }}

# The two shares served over webdav, under /data/storage and /data/servarr.
STORAGE_ROOT={{ srv_storage_subvolume }}
MEDIA_ROOT={{ srv_media_root }}

# The single webdav user. rclone has no environment variable for these, they can
# only be passed as command line flags, so they are visible in the container's
# argv to anyone who can inspect it.
WEBDAV_USER={{ webdav_user }}
WEBDAV_PASSWORD={{ webdav_password }}