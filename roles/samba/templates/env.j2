# Rendered by the samba role on every play. Do not edit on the host: the next run
# overwrites this file. Change templates/env.j2 or the vault entry instead.

# The host uid/gid the share is served as.
PUID={{ srv_puid }}
PGID={{ srv_pgid }}

# The share exposed over smb.
MEDIA_ROOT={{ srv_media_root }}

# The only smb user. Avoid ';' and '"' in either value: dperson/samba uses ';'
# as its field separator in the -u argument.
SMB_USER={{ samba_user }}
SMB_PASSWORD={{ samba_password }}