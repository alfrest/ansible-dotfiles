# Rendered by the nextcloud role on every play. Do not edit on the host: the next
# run overwrites this file. Change templates/env.j2 or the vault entry instead.

# The host uid/gid the containers run as.
PUID={{ srv_puid }}
PGID={{ srv_pgid }}

TZ={{ srv_timezone }}

# Per-stack config state.
CONTAINER_ROOT={{ srv_container_root }}

# Snappered btrfs volume, which is where the uploaded data lives.
STORAGE_ROOT={{ srv_storage_subvolume }}