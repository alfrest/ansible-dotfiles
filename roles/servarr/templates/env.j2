# Rendered by the servarr role on every play. Do not edit on the host: the next
# run overwrites this file. Change templates/env.j2 or the vault entry instead.

# The host uid/gid the containers run as.
PUID={{ srv_puid }}
PGID={{ srv_pgid }}

TZ={{ srv_timezone }}

# Per-service config state, one directory per service.
CONTAINER_ROOT={{ srv_container_root }}

# The media library sonarr, radarr, qbittorrent and jellyfin all share.
MEDIA_ROOT={{ srv_media_root }}

# flaresolverr only, kept at their upstream defaults unless you set them here.
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none