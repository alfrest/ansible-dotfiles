# Rendered by the immich role on every play. Do not edit on the host: the next run
# overwrites this file. Change templates/env.j2 or the vault entry instead.

# Uploaded media library. Large, so it lives on the snappered btrfs volume.
UPLOAD_LOCATION={{ srv_storage_subvolume }}/container/immich/library

# Postgres data. Network shares are not supported for the database.
DB_DATA_LOCATION={{ srv_container_root }}/immich/postgres

TZ={{ srv_timezone }}

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v3

# The host uid/gid the containers run as.
PUID={{ srv_puid }}
PGID={{ srv_pgid }}

# Connection secret for postgres. Use only the characters `A-Za-z0-9`, without
# special characters or spaces.
DB_PASSWORD={{ immich_db_password }}

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich